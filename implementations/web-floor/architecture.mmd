flowchart LR
  U[User in Browser]

  subgraph B[web-floor Browser Client]
    UI["index.html / cafeteria-ops.html UI controls"]
    JS["app.js: build ONE OpenFloor envelope per user action;<br/>render NDJSON stream incrementally"]
  end

  subgraph G[Flask Gateway: flask_gateway.py]
    FLOOR["POST /api/floor/send · /api/floor/stream · GET /api/floor/state"]
    PROXY["POST /api/proxy-send · /api/proxy-stream (raw single-agent relay)"]
    ROUTER["floor_router.py: Pass-Through / Delegate-to-Convener routing loop"]
    FSTATE["floor_state.py: per-conversation conversant/floor state"]
    STATIC[GET / and static assets]
    POLICY["CORS_ALLOW_ORIGINS; optional GATEWAY_TARGET_ALLOWLIST"]
  end

  subgraph A[OpenFloor Agents]
    C[Convener]
    S[Specialist agents]
    R[Remote or web agents HTTPS]
  end

  U --> UI --> JS
  U --> STATIC
  JS --> FLOOR
  JS --> PROXY

  FLOOR --> ROUTER --> FSTATE
  ROUTER -- "Pass-Through / Delegate / courtesy-copy" --> C
  ROUTER -- "Pass-Through" --> S
  ROUTER -- "resumeAfterFloorHolder re-request" --> S
  C -- "decision events (grant/revoke/invite/utterance)" --> ROUTER
  S -- "reply, or transient floorHolder status" --> ROUTER

  PROXY --> S
  PROXY --> R
  R --> PROXY

  ROUTER --> JS
  PROXY --> JS
  JS --> U

  POLICY --> FLOOR
  POLICY --> PROXY
  JS --> Q[Gateway override option] --> FLOOR
